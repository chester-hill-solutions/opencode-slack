# --- Slack app credentials ---------------------------------------------
# Bot token (xoxb-...), from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=xoxb-your-token
# App-level token (xapp-...) with the `connections:write` scope.
# Required for Socket Mode (the default; no public URL needed).
SLACK_APP_TOKEN=xapp-your-token

# --- OpenCode connection ------------------------------------------------
# Option A (default): connect to the local OpenCode background service.
# Leave OPENCODE_URL unset and the bot will discover/start it automatically.

# Option B: connect to an explicit OpenCode server (e.g. a Railway deployment).
# OPENCODE_URL=https://your-opencode.example.com
# Either a bearer token:
# OPENCODE_TOKEN=your-opencode-token
# ...or a full Authorization header value (useful for Caddy basic auth):
# OPENCODE_AUTH_HEADER=Basic base64userpass=

# Directory used for NEW OpenCode sessions started from Slack.
# Defaults to the bot process's current working directory.
# OPENCODE_DIRECTORY=/path/to/your/project

# Model for NEW Slack sessions: provider/model or provider/model#variant.
# Omit to use the location's default model.
# OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash

# How often the bot refreshes its in-thread "working…" progress message.
# One message per run, updated in place; deleted when the run finishes.
# OPENCODE_SLACK_CHECKIN_SECONDS=45

# Where the thread -> session mapping is stored.
# Defaults to ~/.local/share/opencode-slack/state.json
# OPENCODE_SLACK_STATE=/path/to/state.json
